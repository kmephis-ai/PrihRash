{
  "name": "prihrash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "package:function": "npm run build --silent && npm run package:function:from-build --silent",
    "readiness:invoke": "node scripts/invoke-yandex-readiness.mjs",
    "resource-limits:invoke": "node scripts/invoke-yandex-resource-limits.mjs",
    "test": "npm run build --silent && npm run test:from-build --silent",
    "test:domain": "npm run build --silent && node --test tests/domain/*.test.mjs",
    "test:source-normalizer": "npm run build --silent && node --test tests/source-normalizer/*.test.mjs",
    "test:migration-simulation": "npm run build --silent && node --test tests/migration-simulation/*.test.mjs",
    "test:schema": "node --test tests/schema/*.test.mjs",
    "test:ydb-adapter": "npm run build --silent && node --test tests/integration/*.test.mjs",
    "privacy": "node scripts/privacy-smoke.mjs",
    "check": "npm run privacy && npm run lint && npm run typecheck && npm run build && npm run test:from-build && npm run package:function:from-build && npm run package:schema-bootstrap:from-build && npm run package:schema-upgrade-003:from-build && npm run package:schema-upgrade-004:from-build && npm run package:initial-bootstrap:from-build && npm run package:initial-bootstrap-recovery:from-build && npm run package:initial-controlled-rebuild:from-build && npm run package:initial-bootstrap-stale-validated-terminalization:from-build && npm run package:wu7-temp-throttling:from-build",
    "preview:build": "node scripts/build-r2-ui-preview.mjs",
    "preview:r2": "npm run preview:build --silent && node scripts/serve-r2-ui-preview.mjs",
    "package:schema-bootstrap": "npm run build --silent && npm run package:schema-bootstrap:from-build --silent",
    "schema-bootstrap:invoke": "node scripts/invoke-yandex-schema-bootstrap.mjs",
    "package:schema-upgrade-003": "npm run build --silent && npm run package:schema-upgrade-003:from-build --silent",
    "schema-upgrade-003:invoke": "node scripts/invoke-yandex-schema-upgrade-003.mjs",
    "package:initial-bootstrap": "npm run build --silent && npm run package:initial-bootstrap:from-build --silent",
    "initial-bootstrap:invoke": "node scripts/invoke-yandex-initial-bootstrap.mjs",
    "package:initial-bootstrap-recovery": "npm run build --silent && npm run package:initial-bootstrap-recovery:from-build --silent",
    "initial-bootstrap-recovery:invoke": "node scripts/invoke-yandex-initial-bootstrap-recovery.mjs",
    "test:browser": "npm run preview:build --silent && playwright test --config=playwright.config.mjs",
    "test:from-build": "node --test tests/domain/*.test.mjs tests/reference/*.test.mjs tests/source-normalizer/*.test.mjs tests/migration-simulation/*.test.mjs tests/schema/*.test.mjs tests/integration/*.test.mjs tests/tooling/*.test.mjs",
    "package:function:from-build": "node scripts/package-yandex-function.mjs && node scripts/verify-yandex-function-package.mjs",
    "package:schema-bootstrap:from-build": "node scripts/package-yandex-schema-bootstrap-function.mjs && node scripts/verify-yandex-schema-bootstrap-package.mjs",
    "package:schema-upgrade-003:from-build": "node scripts/package-yandex-schema-upgrade-003-function.mjs && node scripts/verify-yandex-schema-upgrade-003-package.mjs",
    "package:initial-bootstrap:from-build": "node scripts/package-yandex-initial-bootstrap-function.mjs && node scripts/verify-yandex-initial-bootstrap-package.mjs",
    "package:initial-bootstrap-recovery:from-build": "node scripts/package-yandex-initial-bootstrap-recovery-function.mjs && node scripts/verify-yandex-initial-bootstrap-recovery-package.mjs",
    "package:initial-controlled-rebuild": "npm run build --silent && npm run package:initial-controlled-rebuild:from-build --silent",
    "initial-controlled-rebuild:invoke": "node scripts/invoke-yandex-initial-controlled-rebuild.mjs",
    "package:initial-controlled-rebuild:from-build": "node scripts/package-yandex-initial-controlled-rebuild-function.mjs && node scripts/verify-yandex-initial-controlled-rebuild-package.mjs",
    "package:initial-bootstrap-stale-validated-terminalization": "npm run build --silent && npm run package:initial-bootstrap-stale-validated-terminalization:from-build --silent",
    "package:initial-bootstrap-stale-validated-terminalization:from-build": "node scripts/package-yandex-initial-bootstrap-stale-validated-terminalization-function.mjs && node scripts/verify-yandex-initial-bootstrap-stale-validated-terminalization-package.mjs",
    "package:schema-upgrade-004": "npm run build --silent && npm run package:schema-upgrade-004:from-build --silent",
    "schema-upgrade-004:invoke": "node scripts/invoke-yandex-schema-upgrade-004.mjs",
    "package:schema-upgrade-004:from-build": "node scripts/package-yandex-schema-upgrade-004-function.mjs && node scripts/verify-yandex-schema-upgrade-004-package.mjs",
    "package:wu7-temp-throttling": "npm run build --silent && npm run package:wu7-temp-throttling:from-build --silent",
    "package:wu7-temp-throttling:from-build": "node scripts/package-yandex-wu7-temporary-throttling-function.mjs && node scripts/verify-yandex-wu7-temporary-throttling-package.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@ydbjs/api": "6.0.7",
    "@ydbjs/auth": "6.3.1",
    "@ydbjs/auth-yandex-cloud": "0.2.0",
    "@ydbjs/core": "6.3.1",
    "@ydbjs/query": "6.3.0",
    "@ydbjs/value": "6.0.8",
    "google-auth-library": "11.0.2"
  }
}
