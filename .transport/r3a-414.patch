 docs/R3A_PREVIEW_WRITER.md                    |  10 +-
 tests/integration/r2-safe-ui-preview.test.mjs | 225 ++++++++++++++++++
 web/preview-transfer-writer-delivery.mjs      |  76 ++++++
 3 files changed, 307 insertions(+), 4 deletions(-)
